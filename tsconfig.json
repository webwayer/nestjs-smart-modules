{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "useDefineForClassFields": false,
    "strict": true,
    // Config classes declare properties without initializers by design —
    // values are provided through DI (same convention as NestJS itself).
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "build",
    "declaration": true,
    "declarationMap": true
  },
  "exclude": ["node_modules", "build", "coverage"]
}
