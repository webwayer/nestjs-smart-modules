{
  "name": "nestjs-smart-modules",
  "version": "1.1.2",
  "description": "A lightweight, type-safe library that simplifies NestJS module configuration. Build composable applications with centralized configuration and zero boilerplate.",
  "keywords": [
    "nestjs",
    "configuration",
    "config",
    "modules",
    "configurable",
    "smart",
    "typescript",
    "dependency-injection",
    "composable",
    "type-safe"
  ],
  "homepage": "https://github.com/webwayer/nestjs-smart-modules#readme",
  "bugs": {
    "url": "https://github.com/webwayer/nestjs-smart-modules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webwayer/nestjs-smart-modules.git"
  },
  "license": "MIT",
  "author": {
    "name": "Rodion Balandin",
    "email": "webwayer@gmail.com"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "build/cjs/index.js",
  "types": "build/cjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "build/**/*",
    "src/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=18.16.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/testing": "^11.1.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.3",
    "knip": "^6.32.0",
    "open-cli": "^9.0.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.23",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^8 || ^9 || ^10 || ^11"
  },
  "scripts": {
    "build": "rimraf build && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/write-dual-markers.mjs",
    "build:watch": "tsc --watch",
    "clean": "rimraf build coverage node_modules/.cache",
    "coverage": "jest --collectCoverage --testPathIgnorePatterns=spec/receipts",
    "coverage:open": "npm run coverage && open-cli coverage/lcov-report/index.html",
    "format": "prettier --write \"src/**/*.ts\" \"spec/**/*.ts\" \"**/*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"spec/**/*.ts\" \"**/*.{json,md,yml,yaml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "jest --runInBand --detectOpenHandles",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run coverage && npm run check:knip && npm run build && npm run check:package",
    "check:package": "publint && attw --pack .",
    "check:knip": "knip",
    "docs:api": "typedoc",
    "check:mutation": "stryker run"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "html",
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
